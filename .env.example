# ---------------------------------------------------------------
# Sprinkle & Sparkle Admin — environment variables
# Copy to .env and fill in. NEVER commit .env.
# None of these are exposed to the browser (no NEXT_PUBLIC_ prefix).
# ---------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sprinkle_sparkle?schema=public"

# Better Auth — generate with: npx @better-auth/cli secret  (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
# Public URL of this admin app (used for cookies, redirects and CSRF origin checks)
BETTER_AUTH_URL="http://localhost:3001"

# Comma-separated storefront origins allowed to call /api/public/* from a browser (CORS)
STOREFRONT_ORIGINS="http://localhost:3000"

# Image storage provider: "local" (dev) | "s3" (AWS S3, Cloudflare R2, MinIO, etc.)
STORAGE_PROVIDER="local"
# Public base URL that stored files are served from.
# local: leave empty to serve via this app at /media/*
STORAGE_PUBLIC_BASE_URL=""
# Max upload size in megabytes
UPLOAD_MAX_MB="5"

# --- S3-compatible storage (only when STORAGE_PROVIDER="s3") ---
# AWS S3:        S3_ENDPOINT="https://s3.<region>.amazonaws.com"
# Cloudflare R2: S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"  S3_REGION="auto"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Initial super admin (used by `npm run admin:create` if flags are omitted) ---
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Super Admin"
