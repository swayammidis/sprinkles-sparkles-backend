# ---------------------------------------------------------------
# Sprinkle & Sparkle Admin: environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# None of these are exposed to the browser (no NEXT_PUBLIC_ prefix).
# ---------------------------------------------------------------

# MongoDB Atlas connection string. The password must be URL-encoded
# (e.g. @ → %40, # → %23, / → %2F). Database name: sprinkle_sparkle
MONGODB_URI=

# Auth.js secret for signing/encrypting sessions. Generate with: npx auth secret
# (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
AUTH_SECRET=

# Required when self-hosting (not needed on Vercel). Also set AUTH_URL in production,
# e.g. AUTH_URL=https://admin.yourdomain.com
AUTH_TRUST_HOST=true

# ---- API smoke test (npm run test:api) — optional, server-only -------------
# Target server and an existing admin account (SUPER_ADMIN recommended). See docs/API-SMOKE-TEST.md.
API_TEST_BASE_URL=http://localhost:3001
API_TEST_ADMIN_EMAIL=
API_TEST_ADMIN_PASSWORD=
# Required to point the test at anything other than localhost:
# API_TEST_ALLOW_REMOTE=true

# ---- Customer website ------------------------------------------------------
# Comma-separated website origins allowed to call /api/public/* from a browser (CORS).
STOREFRONT_ORIGINS=http://localhost:3000

# ---- Image storage -----------------------------------------------------------
# "local" = files saved in ./storage/uploads and served at /media/* (development / single server).
# "s3"    = any S3-compatible bucket: AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces.
STORAGE_PROVIDER=local
# Public URL the files are served from (required for s3, e.g. https://cdn.yourdomain.com).
STORAGE_PUBLIC_BASE_URL=
# Maximum upload size in MB (images are optimised to WebP, max 2000px, after upload).
UPLOAD_MAX_MB=8
# S3 / R2 settings (only when STORAGE_PROVIDER=s3)
# R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  S3_REGION=auto
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
