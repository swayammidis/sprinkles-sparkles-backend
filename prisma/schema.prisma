// Sprinkle & Sparkle — catalog database schema.
//
// Conventions
// - Money is stored as Decimal(10,2) in INR. Never use Float for money.
// - Weight is stored in grams, dimensions in centimetres.
// - Table/column names are snake_case in PostgreSQL, camelCase in TypeScript.
// - Many-to-many relations use explicit join tables with real foreign keys.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Admin authentication (managed by Better Auth)
// ---------------------------------------------------------------------------

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

model AdminUser {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  role          AdminRole @default(ADMIN)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions AdminSession[]
  accounts AdminAccount[]

  @@map("admin_users")
}

model AdminSession {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_sessions")
}

model AdminAccount {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_accounts")
}

model AdminVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("admin_verifications")
}

// Login rate-limit counters (shared across server instances).
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

// ---------------------------------------------------------------------------
// Catalog taxonomy
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subcategories Subcategory[]
  products      Product[]

  @@index([active, sortOrder])
  @@map("categories")
}

model Subcategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  categoryId  String   @map("category_id")
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products Product[]

  @@index([categoryId, sortOrder])
  @@index([active])
  @@map("subcategories")
}

model Brand {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logo        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([active])
  @@map("brands")
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  bannerImage String?  @map("banner_image")
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products ProductCollection[]

  @@index([active, sortOrder])
  @@map("collections")
}

model Occasion {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products ProductOccasion[]

  @@index([active, sortOrder])
  @@map("occasions")
}

// ---------------------------------------------------------------------------
// Products
// ---------------------------------------------------------------------------

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
  ON_BACKORDER
}

model Product {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  shortDescription String?     @map("short_description")
  description      String?
  sku              String      @unique
  price            Decimal     @db.Decimal(10, 2)
  salePrice        Decimal?    @map("sale_price") @db.Decimal(10, 2)
  /// Lowest price a customer pays (sale price / cheapest active variant).
  /// Derived and maintained by the server on every save; used for sorting & price filters.
  effectivePrice   Decimal     @default(0) @map("effective_price") @db.Decimal(10, 2)
  stockQuantity    Int         @default(0) @map("stock_quantity")
  stockStatus      StockStatus @default(IN_STOCK) @map("stock_status")
  hasVariants      Boolean     @default(false) @map("has_variants")

  categoryId    String? @map("category_id")
  subcategoryId String? @map("subcategory_id")
  brandId       String? @map("brand_id")

  featured   Boolean @default(false)
  newArrival Boolean @default(false) @map("new_arrival")
  bestSeller Boolean @default(false) @map("best_seller")
  active     Boolean @default(false)

  /// grams
  weight Decimal? @db.Decimal(10, 2)
  /// centimetres
  length Decimal? @db.Decimal(10, 2)
  /// centimetres
  width  Decimal? @db.Decimal(10, 2)
  /// centimetres
  height Decimal? @db.Decimal(10, 2)

  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")
  seoImage       String? @map("seo_image")

  /// Marks seed/demo records so they can be removed with `npm run db:remove-demo`.
  isDemo Boolean @default(false) @map("is_demo")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category    Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory Subcategory?        @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  brand       Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  variants    ProductVariant[]
  collections ProductCollection[]
  occasions   ProductOccasion[]

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([brandId])
  @@index([active, createdAt])
  @@index([active, featured])
  @@index([active, newArrival])
  @@index([active, bestSeller])
  @@index([active, effectivePrice])
  @@index([stockStatus])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("products")
}

// At most one primary image per product is enforced by a partial unique index
// created in the initial migration (product_images_one_primary_per_product).
model ProductImage {
  id           String   @id @default(cuid())
  productId    String   @map("product_id")
  mediaAssetId String?  @map("media_asset_id")
  url          String
  altText      String?  @map("alt_text")
  sortOrder    Int      @default(0) @map("sort_order")
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")

  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset?      @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  variants   ProductVariant[]

  @@index([productId, sortOrder])
  @@index([mediaAssetId])
  @@map("product_images")
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String   @map("product_id")
  name          String
  sku           String   @unique
  price         Decimal  @db.Decimal(10, 2)
  salePrice     Decimal? @map("sale_price") @db.Decimal(10, 2)
  stockQuantity Int      @default(0) @map("stock_quantity")
  /// grams
  weight        Decimal? @db.Decimal(10, 2)
  imageId       String?  @map("image_id")
  sortOrder     Int      @default(0) @map("sort_order")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product    Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  image      ProductImage?      @relation(fields: [imageId], references: [id], onDelete: SetNull)
  attributes VariantAttribute[]

  @@index([productId, sortOrder])
  @@map("product_variants")
}

// Generic name/value attributes so variants are not tied to a single axis.
// e.g. { name: "Size", value: "8 inch" }, { name: "Colour", value: "Pink" }.
model VariantAttribute {
  id        String @id @default(cuid())
  variantId String @map("variant_id")
  name      String
  value     String

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, name])
  @@index([name, value])
  @@map("variant_attributes")
}

model ProductCollection {
  productId    String   @map("product_id")
  collectionId String   @map("collection_id")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId, sortOrder])
  @@map("product_collections")
}

model ProductOccasion {
  productId  String   @map("product_id")
  occasionId String   @map("occasion_id")
  createdAt  DateTime @default(now()) @map("created_at")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  occasion Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  @@id([productId, occasionId])
  @@index([occasionId])
  @@map("product_occasions")
}

// ---------------------------------------------------------------------------
// Media library — metadata only. Binary files live in object storage.
// ---------------------------------------------------------------------------

model MediaAsset {
  id         String   @id @default(cuid())
  /// Provider that stored the file: "local" | "s3" | ...
  provider   String
  /// Provider-specific object key, e.g. "products/2026/09/abc.webp"
  key        String   @unique
  url        String
  filename   String
  mimeType   String   @map("mime_type")
  size       Int
  isDemo     Boolean  @default(false) @map("is_demo")
  uploadedBy String?  @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  productImages ProductImage[]

  @@index([createdAt])
  @@map("media_assets")
}
